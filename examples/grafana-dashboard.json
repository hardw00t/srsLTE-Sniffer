{
  "title": "srsLTE-Sniffer",
  "uid": "srslte-sniffer",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["srslte", "rrc", "lte"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Paging rate (per kind)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$ds"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(srslte_pagings_total[1m])",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 2,
      "title": "Decode failures",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$ds"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(srslte_decode_failures_total[5m])",
          "refId": "A",
          "legendFormat": "failures/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "Backpressure drops",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "$ds"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "targets": [
        {"expr": "increase(srslte_pipeline_dropped_total[5m])"}
      ]
    },
    {
      "id": 4,
      "title": "Anomalies (rule × severity)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "$ds"},
      "gridPos": {"h": 6, "w": 18, "x": 6, "y": 8},
      "targets": [
        {
          "expr": "increase(srslte_anomaly_events_total[1h])",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Decode latency (p50/p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$ds"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(srslte_decode_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(srslte_decode_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  }
}
